// Native binder call statistics used by libbinder (factory PICO OS
// libbinder_call_stat.so, VNDK-SP).
cc_library_shared {
    name: "libbinder_call_stat",

    vendor_available: true,
    vndk: {
        enabled: true,
        support_system_process: true,
    },

    // Same translation unit order as the factory library.
    srcs: [
        "UidEntry.cpp",
        "BinderCallsStat.cpp",
    ],

    export_include_dirs: ["include"],

    cflags: [
        "-Wall",
        "-Werror",
    ],

    shared_libs: [
        "liblog",
        "libutils",
    ],
    export_shared_lib_headers: ["libutils"],

    sanitize: {
        misc_undefined: ["integer"],
    },
}
